# ============================================================
# PrivateVault — environment variable template
# Copy to .env.local and fill in real values.
# NEVER commit .env.local — it is gitignored.
# ============================================================

# ------ Solana -----------------------------------------------
NEXT_PUBLIC_SOLANA_RPC=https://api.devnet.solana.com

# Set after `solana program deploy` in T6
NEXT_PUBLIC_PVAULT_PROGRAM_ID=<set-after-deploy>

# ------ External program IDs (devnet) ------------------------
NEXT_PUBLIC_IKA_PROGRAM_ID=87W54kGYFQ1rgWqMeu4XTPHWXWmXSQCcjm8vCTfiq1oY
NEXT_PUBLIC_ENCRYPT_PROGRAM_ID=4ebfzWdKnrnGseuQpezXdG8yCdHqwQ1SSBHD3bWArND8

# ------ Demo / feature flags ---------------------------------
# true  → stub gRPC calls, mock tx ids, skip real devnet latency
# false → live devnet (Ika + Encrypt gRPC must be reachable)
NEXT_PUBLIC_DEMO_MODE=true

# ------ gRPC bridges (server-side Next.js routes) ------------
IKA_GRPC_URL=https://pre-alpha-dev-1.ika.ika-network.net:443
ENCRYPT_GRPC_URL=https://pre-alpha-dev-1.encrypt.ika-network.net:443

# ------ Pyth price feeds -------------------------------------
# Devnet BTC/USD feed pubkey — get from https://pyth.network/developers/price-feed-ids
PYTH_BTC_USD_FEED=<pyth-devnet-btc-usd-pubkey>

# ------ Keeper daemon ----------------------------------------
KEEPER_KEYPAIR_PATH=./keys/keeper.json
